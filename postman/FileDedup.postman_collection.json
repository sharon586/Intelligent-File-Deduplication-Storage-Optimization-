{
  "info": {
    "name": "File Deduplication & Storage Optimization API",
    "description": "Run 'Register' then 'Login' first; Login stores the JWT in the {{token}} collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "fileId",
      "value": "1"
    },
    {
      "key": "groupId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"shiny\",\n  \"email\": \"shiny@example.com\",\n  \"password\": \"StrongPass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ],
              "query": []
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "shiny",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "StrongPass123",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "OAuth2 password form. 'username' accepts the username or the email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Upload file",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "upload"
              ],
              "query": []
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "Select a file in the 'file' form field. Hashing runs in the background (Celery)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Upload accepted', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('fileId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List files (search, filter, sort, paginate)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "report",
                  "disabled": true
                },
                {
                  "key": "file_type",
                  "value": "document",
                  "disabled": true
                },
                {
                  "key": "min_size",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "max_size",
                  "value": "104857600",
                  "disabled": true
                },
                {
                  "key": "duplicate_status",
                  "value": "any",
                  "disabled": false
                },
                {
                  "key": "date_from",
                  "value": "2026-01-01",
                  "disabled": true
                },
                {
                  "key": "date_to",
                  "value": "2026-12-31",
                  "disabled": true
                },
                {
                  "key": "sort_by",
                  "value": "uploaded_at",
                  "disabled": false
                },
                {
                  "key": "sort_order",
                  "value": "desc",
                  "disabled": false
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "page_size",
                  "value": "20",
                  "disabled": false
                }
              ]
            },
            "description": "duplicate_status: any | duplicate | original | unique. sort_by: uploaded_at | name | size | type."
          }
        },
        {
          "name": "Get file details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Download file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}",
                "download"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Delete preview (storage impact)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/delete-preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}",
                "delete-preview"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Delete file (confirmed)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}"
              ],
              "query": [
                {
                  "key": "confirm",
                  "value": "true",
                  "disabled": false
                },
                {
                  "key": "reason",
                  "value": "Removing duplicate",
                  "disabled": false
                }
              ]
            }
          }
        },
        {
          "name": "Protect / unprotect file",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/protect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}",
                "protect"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_protected\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Re-run analysis",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/reprocess",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}",
                "reprocess"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Duplicates",
      "item": [
        {
          "name": "List duplicate groups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/duplicates/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "duplicates",
                "groups"
              ],
              "query": [
                {
                  "key": "sort_by",
                  "value": "savings",
                  "disabled": false
                },
                {
                  "key": "sort_order",
                  "value": "desc",
                  "disabled": false
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "page_size",
                  "value": "10",
                  "disabled": false
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.items && d.items.length) { pm.collectionVariables.set('groupId', d.items[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get duplicate group",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/duplicates/groups/{{groupId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "duplicates",
                "groups",
                "{{groupId}}"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Clean up group (keep original)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/duplicates/groups/{{groupId}}/cleanup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "duplicates",
                "groups",
                "{{groupId}}",
                "cleanup"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirm\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rescan all groups (background)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/duplicates/rescan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "duplicates",
                "rescan"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Analytics & History",
      "item": [
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "analytics",
                "summary"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Deletion history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/deletions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "history",
                "deletions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "page_size",
                  "value": "20",
                  "disabled": false
                }
              ]
            }
          }
        },
        {
          "name": "Audit log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "history",
                "audit"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "page_size",
                  "value": "20",
                  "disabled": false
                }
              ]
            }
          }
        }
      ]
    }
  ]
}