# ------------------------------------------------------------------
# Copy this file to ".env" in the project root and adjust the values.
# Used by docker-compose.yml. For running the backend outside Docker,
# copy backend/.env.example to backend/.env instead.
# ------------------------------------------------------------------

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=dedup_db
MYSQL_USER=dedup
MYSQL_PASSWORD=change_me_db_password

# Backend
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-in-production-use-48-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=500
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BLOCKED_EXTENSIONS=exe,bat,cmd,com,scr,msi,dll,sh,ps1,vbs,jar,apk

# Ports exposed on your machine
BACKEND_PORT=8000
FRONTEND_PORT=3000
