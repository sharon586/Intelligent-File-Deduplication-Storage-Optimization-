# Settings for running the backend directly (without Docker).
PROJECT_NAME=File Deduplication & Storage Optimization API
LOG_LEVEL=INFO

DATABASE_URL=mysql+pymysql://dedup:change_me_db_password@localhost:3306/dedup_db
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-this-secret-key-in-production-use-48-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=500
HASH_CHUNK_SIZE=1048576

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BLOCKED_EXTENSIONS=exe,bat,cmd,com,scr,msi,dll,sh,ps1,vbs,jar,apk

# Set to true to run Celery tasks inline (no Redis/worker needed) - handy for quick local tests only.
CELERY_TASK_ALWAYS_EAGER=false
MYSQL_PORT=3307